{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tic-rating",
  "pages_build_output_dir": "./web",
  "compatibility_date": "2026-07-31",
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "4b38fb0b4cd24c48a02a2eb1b9782f8d"
    }
  ],
  "vars": {
    "LLM_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "OPENAI_REASONING_EFFORT": "low",
    "LLM_MAX_TOKENS": "4000"
  }
}
