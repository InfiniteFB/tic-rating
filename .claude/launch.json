      "port": 8139
    },
    {
      "name": "web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "devserve.py",
        "--port",
        "8143",
        "--directory",
        "web"
      ],
      "port": 8143
    },
    {
      "name": "web-b",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "devserve.py",
        "--port",
        "8144",
        "--directory",
        "web"
      ],
      "port": 8144
    }
  ]
}
