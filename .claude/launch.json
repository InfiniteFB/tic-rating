{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kmv-api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8137"
      ],
      "port": 8137
    },
    {
      "name": "design-prototypes",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8139",
        "--directory",
