{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/series/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }]
    },
    {
      "source": "/data/index.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, s-maxage=3600" }]
    }
  ]
}
