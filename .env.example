MASSIVE_API_KEY=your-massive-key
# LLM narration channel: openai | anthropic (switch here, nothing else to touch)
LLM_PROVIDER=openai
# -- anthropic-compatible channel (MiniMax or any Anthropic-Messages endpoint) --
LLM_API_KEY=your-llm-key
LLM_BASE_URL=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M3
# -- openai channel (OPENAI_BASE_URL optional, defaults to the official API) --
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-5.6-luna
